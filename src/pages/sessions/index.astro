---
import SiteLayout from "../../layouts/SiteLayout.astro";
import SessionsGrid from "../../components/SessionsGrid.astro";
import { sessionLabels, siteConfig } from "../../site-config";
---

<SiteLayout
  title={sessionLabels.plural}
  description={`The twelve-week teaching schedule: what happens in each ${sessionLabels.singular.toLowerCase()}, what to prepare, and what leaves the room.`}
  {...siteConfig}
>
  <p>
    A {sessionLabels.singular} is where the week's claim gets tested on you
    rather than discussed. Most weeks that means napping under observation and
    measuring what it did, using the two instruments taught in the first lab: a
    Karolinska reading you take on yourself, and a reaction-time median that
    routinely disagrees with it. Where those two disagree is usually the week's
    real material.
  </p>
  <SessionsGrid />
</SiteLayout>
