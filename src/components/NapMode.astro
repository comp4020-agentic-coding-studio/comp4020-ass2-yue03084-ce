---
import "../styles/nap-mode.css";
---

{/*
  When it updates: on click, on every page load (including view transitions),
  and once a second while a nap is running down.
  What must not change: the SlopU brand colours, the page's structure, and the
  reader's light/dark choice. Nap Mode moves tokens and one font size; it does
  not restyle a single component.
*/}
<div class="nap-mode">
  <button
    class="nap-mode__button"
    type="button"
    aria-pressed="false"
    data-nap-toggle
  >
    <span data-nap-label>Nap mode</span>
    <span class="nap-mode__time" aria-hidden="true" data-nap-time></span>
  </button>
</div>

<script>
  import { NAP_MS, NAP_STORAGE_KEY } from "../nap-mode";

  const root = document.documentElement;

  // Storage is the authority; `memory` is the fallback for when it throws
  // (private windows, blocked site data), so a nap still works there and
  // merely stops outliving the page.
  //
  // It reads as the safer choice to take whichever of the two is later. It
  // isn't: memory is per-tab, so the maximum of the two lets a stale tab
  // outvote storage — waking up in one tab would leave another napping, and
  // the napping tab would then write its own expiry back. One authority, one
  // named fallback. Because the tick below re-reads storage every second,
  // this also means ending a nap in one tab ends it in all of them.
  let memory = 0;
  let ticking: ReturnType<typeof setInterval> | null = null;

  /** The nap's expiry, or 0 when there is no nap running. */
  function readUntil(): number {
    let until: number;
    try {
      const stored = Number(localStorage.getItem(NAP_STORAGE_KEY));
      until = Number.isFinite(stored) ? stored : 0;
    } catch {
      until = memory;
    }
    return until > Date.now() ? until : 0;
  }

  function writeUntil(until: number): void {
    memory = until;
    try {
      if (until) localStorage.setItem(NAP_STORAGE_KEY, String(until));
      else localStorage.removeItem(NAP_STORAGE_KEY);
    } catch {
      /* Memory already holds it. */
    }
  }

  /** Fold an open menu shut, so a nap starts from the collapsed state. */
  function collapseNav(): void {
    for (const toggle of document.querySelectorAll(".at-nav-toggle")) {
      toggle.setAttribute("aria-expanded", "false");
    }
  }

  // The theme decides nav link reachability from whether its toggle is visible
  // and expanded; Nap Mode changes the first of those, so it owes the same
  // sync afterwards. Same condition as the theme's own `syncNavInert`, because
  // two answers to "are these links reachable?" is one answer too many.
  //
  // Order matters and cost a bug: this reads computed style, so it has to run
  // *after* `data-nap` is on the element, or it measures the nav the nap has
  // not collapsed yet and leaves hidden links in the tab order. `render` calls
  // it last for exactly that reason.
  function syncNavInert(): void {
    for (const wrapper of document.querySelectorAll<HTMLElement>(".at-nav-links-wrapper")) {
      const toggle = wrapper.closest(".at-nav")?.querySelector(".at-nav-toggle");
      if (!toggle) continue;
      wrapper.inert =
        getComputedStyle(toggle).display !== "none" &&
        toggle.getAttribute("aria-expanded") !== "true";
    }
  }

  /** Everything the nap state shows, from the one value that decides it. */
  function render(until: number): void {
    const napping = until > 0;
    if (napping) root.dataset.nap = "on";
    else delete root.dataset.nap;

    const minutesLeft = napping ? Math.ceil((until - Date.now()) / 60_000) : 0;
    for (const button of document.querySelectorAll<HTMLElement>("[data-nap-toggle]")) {
      button.setAttribute("aria-pressed", String(napping));
      const label = button.querySelector("[data-nap-label]");
      const time = button.querySelector("[data-nap-time]");
      if (label) label.textContent = napping ? "Wake up" : "Nap mode";
      // Visual only — `aria-hidden` on the element, because a countdown
      // announced every second is not an accessibility feature.
      if (time) time.textContent = napping ? `${minutesLeft} min` : "";
    }

    // Last, and inside `render` rather than at the call sites, because it
    // reads computed style and so must follow `data-nap`. Keeping it here
    // cost a second bug to learn: when the nap expired on its own the tick
    // called `render` but not the sync, so the nav came back visible and
    // still `inert` — links on screen that the keyboard could not reach.
    // Reachability follows from nap state, so it belongs with it.
    syncNavInert();
  }

  function tick(): void {
    const until = readUntil();
    if (!until) writeUntil(0);
    render(until);
    if (until && !ticking) ticking = setInterval(tick, 1000);
    if (!until && ticking) {
      clearInterval(ticking);
      ticking = null;
    }
  }

  function onClick(): void {
    const until = readUntil() ? 0 : Date.now() + NAP_MS;
    writeUntil(until);
    if (until) collapseNav();
    tick();
  }

  // Bind once per button, then re-bind after each view transition — the
  // theme's `Nav` script uses the same guarded-setup shape, so both survive
  // navigation the same way.
  function setup(): void {
    for (const button of document.querySelectorAll("[data-nap-toggle]")) {
      if (button.hasAttribute("data-nap-initialized")) continue;
      button.setAttribute("data-nap-initialized", "true");
      button.addEventListener("click", onClick);
    }
    tick();
  }

  setup();
  document.addEventListener("astro:page-load", setup);
</script>
